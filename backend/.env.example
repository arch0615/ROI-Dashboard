NODE_ENV=development
HOST=127.0.0.1
PORT=4000
DB_PATH=./data.db

# Seed admin user (only used on first boot when users table is empty)
DASHBOARD_USER=admin
DASHBOARD_PASS=change-me

# AES-256-GCM key for encrypting OAuth refresh tokens. 64 hex chars / 32 bytes.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Google Ads API (M3 sync engine). All three required for any /customers
# or /sync call. Without these, those endpoints return 503 NOT_CONFIGURED.
# Apply for a developer token at https://ads.google.com/aw/apicenter
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DEVELOPER_TOKEN=
